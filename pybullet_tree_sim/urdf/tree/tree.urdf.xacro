<?xml version="1.0"?>
<robot name="tree" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:include filename="./tree_macro.urdf.xacro" />

    <xacro:arg name="tree_name" default=""/>
    <xacro:arg name="parent" default="world" />    

    <xacro:tree_macro
        tree_name="$(arg tree_name)"
        parent="$(arg parent)" >
    </xacro:tree_macro>

</robot>
